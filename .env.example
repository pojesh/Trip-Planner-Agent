# Copy to .env and fill in. Never commit .env.

# --- LLM for the planner agent and the support assistant ---
# "groq" (Groq Cloud) or "gemini" (Google). Only the chosen provider's key is needed.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_S=45

# --- Support assistant (RAG over the policy PDFs in rag/data) ---
# Destinations in HOME_COUNTRY are "domestic"; everything else is "international".
HOME_COUNTRY=India
RAG_DATA_DIR=rag/data
CHROMA_DIR=rag/chroma
# Local sentence-transformers model (downloaded once, then works offline).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Cosine relevance below this counts as "no relevant policy" (the assistant then says it doesn't know).
RAG_SCORE_THRESHOLD=0.5
RAG_TOP_K=5

# --- Open data providers ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
# Used automatically when the main Overpass server is busy (it often returns 504 at peak times).
OVERPASS_FALLBACK_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter
# FOSSGIS OSRM server: has real foot + car profiles (router.project-osrm.org is car-only).
ROUTING_BASE_URL=https://routing.openstreetmap.de

# Public OSM services require an identifying User-Agent (app name + a real contact or project URL).
# Placeholder addresses like example.com are rejected by Nominatim with 403 Forbidden.
HTTP_USER_AGENT=Wayfinder-TripPlanner/1.0 (github.com/POJESH/Trip-Planner-Agent)

# --- Storage ---
SQLITE_PATH=data/trip_planner.db

# --- Timeouts (seconds) ---
NOMINATIM_TIMEOUT_S=6
OVERPASS_TIMEOUT_S=25
ROUTING_TIMEOUT_S=8

# --- Frontend ---
BACKEND_BASE_URL=http://127.0.0.1:8000
